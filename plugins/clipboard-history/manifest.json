{
  "id": "com.tuffex.clipboard-history",
  "name": "clipboard-history",
  "version": "1.2.0-beta.6",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "utilities",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": "一款全平台剪贴板历史记录插件，从 Tuff 核心提取剪贴板历史。",
  "dev": {
    "enable": false,
    "address": "http://127.0.0.1:3488",
    "source": true,
    "autoStart": true
  },
  "build": {
    "index": {
      "entry": "index/main.ts",
      "format": "cjs",
      "target": "node24",
      "external": ["electron"],
      "minify": true,
      "sourcemap": false
    }
  },
  "permissions": {
    "required": ["clipboard.read", "clipboard.write", "fs.tfile", "search.root-results", "system.applications"],
    "optional": ["system.shell"]
  },
  "permissionReasons": {
    "clipboard.read": "读取剪贴板历史记录并展示详情",
    "clipboard.write": "将选中的剪贴记录重新写回系统剪贴板",
    "fs.tfile": "显示剪贴板图片原图和来源应用图标",
    "search.root-results": "将剪贴板历史入口推送到 CoreBox 根搜索结果",
    "system.applications": "按剪贴记录中的应用标识显示来源应用名称和图标",
    "system.shell": "用默认浏览器打开剪贴记录里的链接，以及在文件管理器中定位剪贴的文件"
  },
  "searchProviders": [
    {
      "id": "clipboard-history.clipboard-history",
      "displayName": "剪贴板历史记录",
      "featureId": "clipboard-history",
      "kind": "plugin-data",
      "owner": "official-plugin",
      "mode": "push",
      "priority": "fast",
      "defaultOrder": 105,
      "permissionScopes": ["root-results"],
      "defaultState": "ask",
      "requiresUserConsent": true,
      "pushesToRootResults": true
    }
  ],
  "features": [
    {
      "id": "clipboard-history",
      "name": "剪贴板历史记录",
      "desc": "查看和管理剪贴板历史记录",
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "push": true,
      "priority": 10,
      "acceptedInputTypes": ["text", "image", "files", "html"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["clipboard-history", "剪贴板历史记录", "剪贴板"]
        }
      ],
      "interaction": {
        "type": "webcontent",
        "path": "/clipboard-manager",
        "showInput": true,
        "allowInput": true,
        "forceMax": true
      }
    }
  ]
}
