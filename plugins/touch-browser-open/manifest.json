{
  "id": "com.tuffex.browser.open",
  "name": "touch-browser-open",
  "version": "1.1.0",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "utilities",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": "浏览器打开：召唤框内直接识别网址与文字，一次回车即用所选浏览器打开且无需二次确认；支持多引擎直搜、热搜快捷入口与可自定义的设置页。",
  "main": "index.js",
  "permissions": {
    "required": ["system.shell", "network.internet", "search.root-results", "storage.plugin"],
    "optional": ["clipboard.write"]
  },
  "permissionReasons": {
    "system.shell": "通过宿主固定启动策略打开浏览器",
    "network.internet": "在默认或选定浏览器中打开网址与搜索结果；显式进入搜索模式后获取搜索建议",
    "search.root-results": "将浏览器打开与网页搜索结果推送到 CoreBox 根搜索结果",
    "storage.plugin": "保存搜索引擎、热搜入口与最近浏览器设置",
    "clipboard.write": "复制链接到剪贴板"
  },
  "searchProviders": [
    {
      "id": "touch-browser-open.browser-open",
      "displayName": "浏览器打开",
      "featureId": "browser-open",
      "kind": "plugin",
      "owner": "official-plugin",
      "mode": "push",
      "priority": "fast",
      "defaultOrder": 70,
      "permissionScopes": ["root-results"],
      "defaultState": "ask",
      "requiresUserConsent": true,
      "pushesToRootResults": true
    },
    {
      "id": "touch-browser-open.web-search",
      "displayName": "网页搜索",
      "featureId": "web-search",
      "kind": "plugin",
      "owner": "official-plugin",
      "mode": "push",
      "priority": "fast",
      "defaultOrder": 71,
      "permissionScopes": ["root-results", "network"],
      "defaultState": "ask",
      "requiresUserConsent": true,
      "pushesToRootResults": true
    }
  ],
  "features": [
    {
      "id": "browser-open",
      "name": {
        "default": "浏览器打开",
        "locales": {
          "zh-CN": "浏览器打开",
          "en-US": "Open in Browser"
        }
      },
      "desc": {
        "default": "快速用默认或指定浏览器打开 URL",
        "locales": {
          "zh-CN": "快速用默认或指定浏览器打开 URL",
          "en-US": "Open a URL in your default or a chosen browser"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["url", "link", "open", "浏览器", "网页", "打开链接", "browser", "chrome", "edge"],
      "push": true,
      "priority": 6,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": false
      },
      "commands": [
        {
          "type": "over",
          "value": ["url", "link", "open", "浏览器", "网页"]
        }
      ]
    },
    {
      "id": "web-search",
      "name": {
        "default": "网页搜索",
        "locales": {
          "zh-CN": "网页搜索",
          "en-US": "Web Search"
        }
      },
      "desc": {
        "default": "使用默认搜索引擎搜索输入内容",
        "locales": {
          "zh-CN": "使用默认搜索引擎搜索输入内容",
          "en-US": "Search what you typed with your default engine"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["search", "web", "google", "bing", "duckduckgo", "搜索", "网页搜索"],
      "push": true,
      "priority": 1,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["search", "web", "google", "bing", "duckduckgo", "搜索", "网页搜索"]
        }
      ]
    },
    {
      "id": "browser-open-settings",
      "name": {
        "default": "浏览器打开设置",
        "locales": {
          "zh-CN": "浏览器打开设置",
          "en-US": "Open in Browser Settings"
        }
      },
      "desc": {
        "default": "管理搜索引擎、热搜快捷入口与默认引擎",
        "locales": {
          "zh-CN": "管理搜索引擎、热搜快捷入口与默认引擎",
          "en-US": "Manage search engines, trending shortcuts and the default engine"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["browser settings", "搜索引擎设置", "热搜设置", "浏览器设置"],
      "push": false,
      "priority": 0,
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "interaction": {
        "type": "webcontent",
        "path": "settings.html",
        "showInput": false,
        "allowInput": false,
        "forceMax": true
      },
      "commands": [
        {
          "type": "contain",
          "value": ["浏览器打开设置", "搜索引擎设置", "热搜设置"]
        }
      ]
    }
  ]
}