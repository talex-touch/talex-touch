{
  "id": "com.tuffex.translation",
  "name": "touch-translation",
  "version": "1.0.18-beta.4",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "utilities",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": "一款全平台资源聚合翻译平台，支持多种翻译服务",
  "main": "index.js",
  "dev": {
    "enable": false,
    "address": "http://localhost:3733/",
    "source": true
  },
  "permissions": {
    "required": ["network.internet", "intelligence.basic", "storage.plugin"],
    "optional": ["clipboard.write"]
  },
  "permissionReasons": {
    "network.internet": "供插件设置 Surface 访问用户显式配置的翻译服务；隔离 Prelude 不直接联网",
    "intelligence.basic": "通过宿主受控智能服务执行文本翻译与图片 OCR",
    "storage.plugin": "供插件设置 Surface 保存启用状态和非敏感翻译源配置；密钥由安全存储管理",
    "clipboard.write": "将翻译结果复制到剪贴板"
  },
  "searchProviders": [],
  "features": [
    {
      "id": "touch-translate",
      "name": {
        "default": "翻译",
        "locales": {
          "zh-CN": "翻译",
          "en-US": "Translate"
        }
      },
      "desc": {
        "default": "翻译选中的文本或剪贴板内容",
        "locales": {
          "zh-CN": "翻译选中的文本或剪贴板内容",
          "en-US": "Translate the selected text or the clipboard"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["translate", "翻译", "fy", "fanyi"],
      "push": false,
      "priority": 10,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["fy", "翻译", "translate"]
        }
      ],
      "interaction": {
        "type": "webcontent",
        "path": "/",
        "showInput": true,
        "allowInput": true,
        "forceMax": true
      }
    },
    {
      "id": "multi-source-translate",
      "name": {
        "default": "多源翻译",
        "locales": {
          "zh-CN": "多源翻译",
          "en-US": "Multi-Source Translate"
        }
      },
      "desc": {
        "default": "同时使用多个翻译源进行翻译",
        "locales": {
          "zh-CN": "同时使用多个翻译源进行翻译",
          "en-US": "Translate with several services at once"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["multi", "多源", "翻译"],
      "push": false,
      "priority": 5,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["fy-multi", "多源翻译"]
        }
      ],
      "interaction": {
        "type": "webcontent",
        "path": "/multi-translate",
        "showInput": true,
        "allowInput": true
      }
    },
    {
      "id": "screenshot-translate",
      "name": {
        "default": "截图翻译",
        "locales": {
          "zh-CN": "截图翻译",
          "en-US": "Screenshot Translate"
        }
      },
      "desc": {
        "default": "截取屏幕区域进行 OCR 识别并翻译",
        "locales": {
          "zh-CN": "截取屏幕区域进行 OCR 识别并翻译",
          "en-US": "Capture part of the screen, recognize its text and translate it"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["screenshot", "截图", "ocr", "识别"],
      "push": false,
      "priority": 5,
      "experimental": true,
      "acceptedInputTypes": ["text", "image"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["s-fy", "截图翻译"]
        }
      ],
      "interaction": {
        "type": "widget",
        "path": "screenshot-translate",
        "showInput": false,
        "allowInput": false,
        "forceMax": true
      }
    }
  ]
}
