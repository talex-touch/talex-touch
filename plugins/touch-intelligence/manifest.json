{
  "id": "com.tuffex.intelligence",
  "name": "touch-intelligence",
  "version": "1.2.0",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "ai",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": "CoreBox 智能问答、内置 AI 命令与本地自定义命令注册表",
  "main": "index.js",
  "dev": {
    "enable": false,
    "source": true,
    "address": "http://127.0.0.1:5174/"
  },
  "permissions": {
    "required": ["intelligence.basic", "search.root-results", "storage.plugin"],
    "optional": ["clipboard.write"]
  },
  "permissionReasons": {
    "intelligence.basic": "调用智能能力完成问答",
    "clipboard.write": "复制 AI 回答或将回答替换到当前应用的选中文本",
    "search.root-results": "将智能问答入口与回答状态推送到 CoreBox 根搜索结果",
    "storage.plugin": "保存本地对话历史与自定义 AI 命令配置"
  },
  "searchProviders": [
    {
      "id": "touch-intelligence.intelligence-ask",
      "displayName": "智能问答",
      "featureId": "intelligence-ask",
      "kind": "ai",
      "owner": "official-plugin",
      "mode": "push",
      "priority": "fast",
      "defaultOrder": 106,
      "permissionScopes": ["root-results"],
      "defaultState": "ask",
      "requiresUserConsent": true,
      "pushesToRootResults": true
    }
  ],
  "features": [
    {
      "id": "intelligence-ask",
      "name": {
        "default": "智能问答",
        "locales": {
          "zh-CN": "智能问答",
          "en-US": "Ask AI"
        }
      },
      "desc": {
        "default": "使用 ai/@ai 前缀在 CoreBox 里调用 AI 回答，支持图片 OCR",
        "locales": {
          "zh-CN": "使用 ai/@ai 前缀在 CoreBox 里调用 AI 回答，支持图片 OCR",
          "en-US": "Ask AI in CoreBox with the ai or @ai prefix; supports image OCR"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["ai", "@ai", "/ai", "智能", "问答", "chat", "助手"],
      "push": true,
      "priority": 200,
      "acceptedInputTypes": ["text", "image"],
      "interaction": {
        "type": "widget",
        "path": "ask-panel",
        "showInput": true,
        "allowInput": true,
        "sendMode": true,
        "forceMax": true
      },
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "match",
          "value": ["ai", "@ai", "/ai", "智能", "问答"]
        }
      ]
    },
    {
      "id": "intelligence-rewrite",
      "name": {
        "default": "AI 改写",
        "locales": {
          "zh-CN": "AI 改写",
          "en-US": "AI Rewrite"
        }
      },
      "desc": {
        "default": "无历史地改写当前文本，只返回改写结果",
        "locales": {
          "zh-CN": "无历史地改写当前文本，只返回改写结果",
          "en-US": "Rewrite the current text without history and return only the result"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["rewrite", "改写", "润色", "ai"],
      "push": true,
      "priority": 195,
      "acceptedInputTypes": ["text"],
      "interaction": {
        "type": "widget",
        "path": "ask-panel",
        "showInput": true,
        "allowInput": true,
        "sendMode": true,
        "forceMax": true
      },
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [{ "type": "match", "value": ["rewrite", "改写"] }]
    },
    {
      "id": "intelligence-summarize",
      "name": {
        "default": "AI 摘要",
        "locales": {
          "zh-CN": "AI 摘要",
          "en-US": "AI Summary"
        }
      },
      "desc": {
        "default": "无历史地提炼当前文本，只返回简洁摘要",
        "locales": {
          "zh-CN": "无历史地提炼当前文本，只返回简洁摘要",
          "en-US": "Summarize the current text without history and return only a short summary"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["summarize", "summary", "总结", "摘要", "ai"],
      "push": true,
      "priority": 194,
      "acceptedInputTypes": ["text"],
      "interaction": {
        "type": "widget",
        "path": "ask-panel",
        "showInput": true,
        "allowInput": true,
        "sendMode": true,
        "forceMax": true
      },
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [{ "type": "match", "value": ["summarize", "summary", "总结", "摘要"] }]
    },
    {
      "id": "intelligence-explain",
      "name": {
        "default": "AI 解释",
        "locales": {
          "zh-CN": "AI 解释",
          "en-US": "AI Explain"
        }
      },
      "desc": {
        "default": "无历史地解释当前文本，只返回解释结果",
        "locales": {
          "zh-CN": "无历史地解释当前文本，只返回解释结果",
          "en-US": "Explain the current text without history and return only the explanation"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["explain", "解释", "说明", "ai"],
      "push": true,
      "priority": 193,
      "acceptedInputTypes": ["text"],
      "interaction": {
        "type": "widget",
        "path": "ask-panel",
        "showInput": true,
        "allowInput": true,
        "sendMode": true,
        "forceMax": true
      },
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [{ "type": "match", "value": ["explain", "解释"] }]
    },
    {
      "id": "intelligence-command-registry",
      "name": {
        "default": "AI 命令管理",
        "locales": {
          "zh-CN": "AI 命令管理",
          "en-US": "AI Commands"
        }
      },
      "desc": {
        "default": "查看、重新加载并打开本地自定义 AI 命令配置",
        "locales": {
          "zh-CN": "查看、重新加载并打开本地自定义 AI 命令配置",
          "en-US": "View, reload and open your local custom AI command config"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["ai commands", "AI 命令", "命令管理", "registry"],
      "push": true,
      "priority": 192,
      "acceptedInputTypes": ["text"],
      "interaction": {
        "type": "widget",
        "path": "command-registry",
        "showInput": false,
        "allowInput": false,
        "sendMode": false,
        "forceMax": true
      },
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "match",
          "value": ["ai commands", "AI命令", "AI 命令", "命令管理"]
        }
      ]
    }
  ]
}
