  "main": "index.js",
  "permissions": {
    "required": ["search.root-results", "fs.read"],
    "optional": ["fs.write", "system.shell"]
  },
  "permissionReasons": {
    "search.root-results": "将 Hosts 配置入口推送到 CoreBox 根搜索结果",
    "fs.read": "读取宿主受限的 Hosts 配置摘要",
    "fs.write": "在确认后原子更新 Hosts 配置",
    "system.shell": "由宿主执行受治理的 Hosts 写入流程"
  },
  "searchProviders": [
    {
      "id": "touch-hosts.hosts",
      "displayName": "Hosts 配置",
      "featureId": "hosts",
      "kind": "plugin",
      "owner": "official-plugin",
      "mode": "push",
      "priority": "fast",
      "defaultOrder": 89,
      "permissionScopes": ["root-results"],
      "defaultState": "ask",
      "requiresUserConsent": true,
      "pushesToRootResults": true
    }
  ],
  "features": [
    {
      "id": "hosts",
      "name": "Hosts 配置",
      "desc": "预览并确认更新受限 Hosts 条目",
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["hosts", "host", "dns", "域名", "解析", "配置"],
      "push": true,
      "priority": 7,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["hosts", "host", "hosts配置", "hosts 配置", "域名解析"]
        }
      ]
    }
