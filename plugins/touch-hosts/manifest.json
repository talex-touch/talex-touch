{
  "id": "com.tuffex.hosts",
  "name": "touch-hosts",
  "version": "0.1.0",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "utilities",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
