      ]
    },
    {
      "id": "quick-actions",
      "name": {
        "default": "系统快捷动作",
        "locales": {
          "zh-CN": "系统快捷动作",
          "en-US": "Quick Actions"
        }
      },
      "desc": {
        "default": "高频安全动作与设置入口",
        "locales": {
          "zh-CN": "高频安全动作与设置入口",
          "en-US": "Frequent safe actions and shortcuts to settings"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["quick", "actions", "快捷", "系统", "锁屏", "静音", "settings"],
      "push": true,
      "priority": 7,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": false
