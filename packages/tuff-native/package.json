{
  "name": "@talex-touch/tuff-native",
  "version": "1.0.0",
  "private": true,
  "description": "Native platform bindings for Talex Touch",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./ocr": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./everything": {
      "types": "./everything.d.ts",
      "require": "./everything.js",
      "default": "./everything.js"
    },
    "./everything-resources": {
      "types": "./everything-resources.d.ts",
      "require": "./everything-resources.js",
      "default": "./everything-resources.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "require": "./audio.js",
      "default": "./audio.js"
    },
    "./translation": {
      "types": "./translation.d.ts",
      "require": "./translation.js",
      "default": "./translation.js"
    },
    "./screenshot-protocol": {
      "types": "./screenshot-protocol.d.ts",
      "require": "./screenshot-protocol.js",
      "node": "./screenshot-protocol.js"
    },
    "./protocol": {
      "types": "./protocol.d.ts",
      "require": "./protocol.js",
      "node": "./protocol.js"
    },
    "./protocol-contract": {
      "types": "./protocol-contract.d.ts",
      "require": "./protocol-contract.js",
      "node": "./protocol-contract.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native-loader.js",
    "binding.gyp",
    "scripts/build-screenshot.js",
    "scripts/verify-screenshot-production.js",
    "scripts/verify-audio-production.js",
    "scripts/build-audio.js",
    "scripts/build-translation.js",
    "scripts/build-update.js",
    "native-update/update.c",
    "build/Release/tuff-native-update",
    "native-translation/TranslationHelper.swift",
    "translation.js",
    "translation.d.ts",
    "build/Release/tuff-native-translation",
    "protocol-contract.js",
    "protocol-contract.d.ts",
    "protocol.js",
    "protocol.d.ts",
    "screenshot-protocol.js",
    "screenshot-protocol.d.ts",
    "Cargo.toml",
    "Cargo.lock",
    "native-core/Cargo.toml",
    "native-core/src",
    "native-napi/Cargo.toml",
    "native-napi/build.rs",
    "native-napi/src",
    "native/src",
    "native-screenshot/Cargo.toml",
    "native-screenshot/build.rs",
    "native-screenshot/src/lib.rs",
    "native-screenshot/src/capability.rs",
    "native-screenshot/src/compose.rs",
    "native-screenshot/src/error.rs",
    "native-screenshot/src/geometry.rs",
    "native-screenshot/src/limits.rs",
    "native-screenshot/src/model.rs",
    "native-screenshot/src/region_plan.rs",
    "native-screenshot/src/window_candidates.rs",
    "native-screenshot/src/backend/mod.rs",
    "native-screenshot/src/backend/unavailable.rs",
    "native-screenshot/src/backend/xcap.rs",
    "native-screenshot/src/backend/macos/mod.rs",
    "native-screenshot/src/backend/macos/actor.rs",
    "native-screenshot/src/backend/macos/ax_actor.rs",
    "native-screenshot/src/backend/macos/implementation.rs",
    "native-screenshot/src/backend/macos/system.rs",
    "native-screenshot/src/backend/macos/system/ax.rs",
    "native-screenshot/src/backend/macos/system/stream.rs",
    "native-audio/Cargo.toml",
    "native-audio/build.rs",
    "native-audio/src",
    "build/Release/*.node",
    "everything.js",
    "everything.d.ts",
    "everything-resources.js",
    "everything-resources.d.ts",
    "audio.js",
    "audio.d.ts",
    "native/src/everything/addon.cc"
  ],
  "gypfile": true,
  "scripts": {
    "install": "node-gyp configure build",
    "build": "node-gyp configure build",
    "build:screenshot": "node scripts/build-screenshot.js",
    "build:audio": "node scripts/build-audio.js",
    "build:translation": "node scripts/build-translation.js",
    "build:update": "node scripts/build-update.js",
    "build:protocol-fixture": "node scripts/build-protocol-fixture.js",
    "test:protocol": "node --test protocol-contract.test.js protocol-napi.test.js protocol-carrier.test.js protocol-package.test.js protocol-error-cause.test.js protocol-error-envelope.test.js",
    "test:screenshot-protocol": "node --test screenshot-addon-contract.test.js screenshot-protocol.test.js",
    "verify:audio-production": "node scripts/verify-audio-production.js",
    "verify:screenshot-production": "node scripts/verify-screenshot-production.js",
    "rebuild": "node-gyp configure build",
    "check:everything": "node scripts/everything-selfcheck.js"
  },
  "dependencies": {
    "node-addon-api": "^7.1.1"
  },
  "devDependencies": {
    "node-gyp": "^11.5.0"
  }
}
