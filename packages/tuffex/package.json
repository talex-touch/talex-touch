{
  "name": "@talex-touch/tuffex",
  "version": "0.9.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "author": "TalexDreamSoul<TalexDreamSoul@gmail.com>",
  "description": "TuffEx - Vue 3 UI source package for the Tuff ecosystem.",
  "license": "(MIT AND Apache-2.0 AND ISC)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "packages/tuffex"
  },
  "homepage": "https://tuff.tagzxia.com",
  "bugs": "https://github.com/talex-touch/tuff/issues",
  "keywords": [
    "tuff",
    "tuffex",
    "talex-touch",
    "vue3",
    "components",
    "ui-library",
    "animation",
    "tactile",
    "glassmorphism"
  ],
  "type": "module",
  "main": "dist/lib/index.js",
  "module": "dist/es/index.js",
  "types": "dist/es/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/lib/index.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/es/components.css",
    "./base.css": "./dist/es/base.css",
    "./utils": {
      "types": "./dist/es/utils/index.d.ts",
      "import": "./dist/es/utils/index.js",
      "require": "./dist/lib/utils/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    },
    "./*/style.css": {
      "import": "./dist/es/*/style.css",
      "require": "./dist/lib/*/style.css"
    },
    "./*": {
      "types": "./dist/es/*/index.d.ts",
      "import": "./dist/es/*/index.js",
      "require": "./dist/lib/*/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "node ./node_modules/gulp/bin/gulp.js -f packages/script/build/index.ts",
    "build:vite": "vite build",
    "dev": "vite build --watch",
    "lint": "pnpm exec eslint --cache .",
    "lint:fix": "pnpm exec eslint --cache --fix .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "audit:exports": "node ./scripts/audit-package-exports.mjs",
    "audit:exports:self-test": "node ./scripts/audit-package-exports.mjs --self-test",
    "audit:types": "node ./scripts/audit-package-types.mjs",
    "audit:types:self-test": "node ./scripts/audit-package-types.mjs --self-test",
    "audit:readme": "node ./scripts/audit-readme-inventory.mjs",
    "audit:readme:self-test": "node ./scripts/audit-readme-inventory.mjs --self-test",
    "audit:vocab": "node ./scripts/audit-prop-vocabularies.mjs",
    "audit:vocab:self-test": "node ./scripts/audit-prop-vocabularies.mjs --self-test",
    "audit:size": "node ./scripts/audit-package-size.mjs",
    "audit:size:self-test": "node ./scripts/audit-package-size.mjs --self-test",
    "audit:cursor": "node ./scripts/audit-interactive-cursor.mjs",
    "audit:cursor:self-test": "node ./scripts/audit-interactive-cursor.mjs --self-test",
    "audit:changelog": "node ./scripts/audit-version-changelog.mjs",
    "audit:changelog:self-test": "node ./scripts/audit-version-changelog.mjs --self-test",
    "audit:colors": "node ./scripts/audit-color-literals.mjs",
    "audit:colors:self-test": "node ./scripts/audit-color-literals.mjs --self-test"
  },
  "files": [
    "dist",
    "AMICRO-LICENSE",
    "AMICRO-APACHE-LICENSE",
    "LUCIDE-LICENSE",
    "REMIXICON-LICENSE"
  ],
  "peerDependencies": {
    "echarts": "^6.1.0",
    "three": ">=0.149.0",
    "vue": "^3.5.27"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/pull-down": "^2.5.1",
    "@better-scroll/pull-up": "^2.5.1",
    "@better-scroll/scroll-bar": "^2.5.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@floating-ui/vue": "^1.1.11",
    "@lezer/highlight": "^1.2.3",
    "@shikijs/engine-javascript": "^4.4.2",
    "@talex-touch/utils": "workspace:^",
    "@types/three": "^0.186.0",
    "@vue/reactivity": "^3.5.27",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.13",
    "gsap": "^3.15.0",
    "katex": "^0.16.45",
    "marked": "catalog:",
    "mermaid": "catalog:",
    "shiki": "^4.4.2",
    "v-wave": "^3.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/gulp": "^4.0.18",
    "@types/gulp-autoprefixer": "^0.0.37",
    "@types/gulp-sass": "^6.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1",
    "echarts": "catalog:",
    "esno": "^4.8.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^9.0.0",
    "postcss": "8.5.23",
    "sass": "^1.101.0",
    "sucrase": "^3.35.1",
    "three": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.6"
  }
}
