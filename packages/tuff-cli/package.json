{
  "name": "@talex-touch/tuff-cli",
  "type": "module",
  "version": "0.1.1",
  "description": "Tuff CLI entrypoint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "packages/tuff-cli"
  },
  "homepage": "https://tuff.tagzxia.com",
  "bugs": "https://github.com/talex-touch/tuff/issues",
  "keywords": [
    "tuff",
    "cli"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tuff": "bin/tuff.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@talex-touch/utils": "workspace:^",
    "@vue/compiler-sfc": "3.5.41",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "compressing": "^2.1.1",
    "debug": "^4.4.3",
    "esbuild": "^0.28.1",
    "fs-extra": "^11.3.6",
    "glob": "^13.0.6",
    "pathe": "^1.1.2",
    "unplugin": "^2.3.11",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@talex-touch/tuff-cli-core": "workspace:*",
    "@talex-touch/unplugin-export-plugin": "workspace:*",
    "eslint": "^9.39.4",
    "rimraf": "^5.0.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
