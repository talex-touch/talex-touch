{
  "name": "@talex-touch/tuff-nexus",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "description": "Documentation for Tuff project",
  "scripts": {
    "build": "pnpm -C \"../../packages/tuffex\" run build && node -e \"const os=require('os'); const v8=require('v8'); const gb=n=> (n/1024/1024/1024).toFixed(2); console.log('[build] totalmem_gb', gb(os.totalmem())); console.log('[build] heap_limit_gb', gb(v8.getHeapStatistics().heap_size_limit));\" && NODE_OPTIONS=\"--max-old-space-size=12288\" nuxt build && node build/materialize-docs-index-aliases.mjs && node build/materialize-not-found.mjs && node build/write-early-hints.mjs && node build/write-static-redirects.mjs && node build/trim-content-assets.mjs",
    "check:api-routes": "node build/check-server-api-route-tree.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "audit:contrast:self-test": "node scripts/contrast-audit.mjs --self-test",
    "check:mdc-fences": "node build/check-mdc-fences.mjs",
    "check:doc-parity": "node build/check-doc-translation-parity.mjs",
    "check:demo-registry": "node build/check-demo-registry-orphans.mjs",
    "check:icon-collections": "node build/check-icon-collections.mjs",
    "check:deployment-secrets": "node scripts/deployment-secret-preflight.mjs",
    "provider:legacy:drop": "node scripts/drop-legacy-intelligence-providers.mjs",
    "check:runtime-evidence": "node build/check-runtime-evidence.mjs",
    "check:runtime-evidence:deployed": "node build/check-runtime-evidence.mjs --require-deployed-preview",
    "check:runtime-evidence:template": "node build/check-runtime-evidence.mjs --print-deployed-preview-template",
    "probe:docs-edge-cache": "node scripts/probe-docs-edge-cache.mjs",
    "collect:runtime-evidence:deployed": "node scripts/collect-deployed-preview-evidence.mjs",
    "build:analyze-worker": "node build/check-worker-bundle.mjs",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "dev": "NUXT_USE_CLOUDFLARE_DEV=true CLOUDFLARE_DEV_ENVIRONMENT=preview nuxt dev --port 3200",
    "dev:pure": "nuxt dev --port 3200 --host 127.0.0.1",
    "dev:cf": "NUXT_USE_CLOUDFLARE_DEV=true CLOUDFLARE_DEV_ENVIRONMENT=preview nuxt dev --port 3200",
    "content:reset": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('.data/content', { recursive: true, force: true })\"",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare",
    "preview": "nuxt preview",
    "preview:cf": "pnpm build && npx wrangler pages dev dist --compatibility-date=2024-08-14 --binding NEXUS_LOCAL_PAGES_PREVIEW=true --binding AUTH_ORIGIN=${AUTH_ORIGIN:-http://127.0.0.1:8788} --binding AUTH_SECRET=${AUTH_SECRET:-tuff-local-pages-preview-secret} --binding APP_AUTH_JWT_SECRET=${APP_AUTH_JWT_SECRET:-tuff-local-app-auth-jwt-secret} --binding NUXT_INTELLIGENCE_ENCRYPT_KEY=${NUXT_INTELLIGENCE_ENCRYPT_KEY:-tuff-local-intelligence-encrypt-key}",
    "deploy:cf": "node scripts/deploy-preview.mjs",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "node build/check-typecheck-plugin-resolution.mjs",
    "test": "vitest run",
    "visual:smoke:tuffex": "node scripts/tuffex-visual-smoke.mjs",
    "openapi:sync": "openapi-typescript ./openapi/nexus-sync.yaml -o ./types/sync-api.d.ts",
    "dev:host": "nuxt dev --port 3200 --host 0.0.0.0",
    "typecheck:raw": "nuxt typecheck"
  },
  "dependencies": {
    "@floating-ui/vue": "catalog:",
    "@iconify-json/cib": "catalog:",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^1.2.20",
    "@langchain/openai": "catalog:",
    "@nuxtjs/mdc": "^0.22.2",
    "@panva/hkdf": "1.2.1",
    "@sentry/nuxt": "catalog:",
    "@sidebase/nuxt-auth": "^0.9.4",
    "@talex-touch/tuff-business": "workspace:*",
    "@talex-touch/tuff-intelligence": "workspace:*",
    "@talex-touch/tuffex": "workspace:*",
    "@talex-touch/utils": "workspace:*",
    "echarts": "^6.1.0",
    "fighting-design": "catalog:",
    "gsap": "catalog:",
    "h3": "1.15.11",
    "jszip": "catalog:",
    "katex": "^0.16.45",
    "mermaid": "catalog:",
    "micromark-extension-math": "^3.1.0",
    "nitropack": "^2.13.4",
    "ogl": "catalog:",
    "simplex-noise": "catalog:",
    "theme-colors": "^0.1.0",
    "typeit": "catalog:",
    "uncrypto": "^0.1.3",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@cloudflare/workers-types": "catalog:dev",
    "@iconify-json/carbon": "catalog:icons",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/twemoji": "catalog:icons",
    "@nuxt/content": "catalog:build",
    "@nuxt/devtools": "catalog:build",
    "@nuxt/eslint": "catalog:build",
    "@nuxtjs/color-mode": "catalog:build",
    "@nuxtjs/i18n": "catalog:build",
    "@pinia/nuxt": "catalog:build",
    "@unocss/eslint-config": "catalog:build",
    "@unocss/nuxt": "catalog:build",
    "@unocss/preset-typography": "catalog:build",
    "@unocss/preset-web-fonts": "^66.7.5",
    "@vite-pwa/nuxt": "catalog:build",
    "@vue/compiler-sfc": "^3.5.41",
    "@vueuse/core": "^14.4.0",
    "baseline-browser-mapping": "catalog:dev",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.1",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "next-auth": "~4.24.15",
    "nitro-cloudflare-dev": "catalog:dev",
    "nuxt": "catalog:build",
    "openapi-typescript": "^7.13.0",
    "pinia": "^3.0.4",
    "sass": "catalog:",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "vitepress": "catalog:",
    "vitest": "^3.2.7",
    "vue": "^3.5.39",
    "vue-tsc": "catalog:dev",
    "webpack": "catalog:dev",
    "wrangler": "catalog:dev"
  }
}
