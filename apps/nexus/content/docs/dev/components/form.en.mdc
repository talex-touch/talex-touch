### Async Validation
An `async` validator runs after the synchronous rules pass, debounces while the user types, and aborts when the value moves on.
:::TuffDemoWrapper{demo="FormAsyncDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  const rules = {
    handle: [
      { required: true },
      { pattern: /^[a-z0-9-]+$/ },
      {
        async validator(value, _rule, _model, { signal }) {
          const res = await fetch(`/api/handles/${value}`, { signal })
          return res.status === 404 || `${value} is taken`
        },
      },
    ],
  }
  </script>

  <template>
    <TxForm :model="form" :rules="rules" :messages="{ validating: 'Checking…' }">
      <TxFormItem label="Handle" prop="handle">
        <TuffInput v-model="form.handle" />
      </TxFormItem>
    </TxForm>
  </template>
---
:::

### Submit and Server Errors
`@submit` runs once every check passes; `setErrors()` inside the handler hands server errors back to their fields.
:::TuffDemoWrapper{demo="FormSubmitDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const formRef = ref()

  async function onSubmit(values) {
    const res = await fetch('/api/accounts', { method: 'POST', body: JSON.stringify(values) })
    if (res.status === 409)
      formRef.value.setErrors({ email: 'This email is already registered' })
    else if (!res.ok)
      formRef.value.setRootError('Could not reach the server. Try again.')
  }
  </script>

  <template>
    <TxForm ref="formRef" v-slot="{ submitting }" :model="form" :rules="rules" @submit="onSubmit">
      <TxFormErrorSummary />
      <TxFormItem label="Nickname" prop="name">
        <TuffInput v-model="form.name" />
      </TxFormItem>
      <TxFormItem label="Email" prop="email">
        <TuffInput v-model="form.email" type="email" />
      </TxFormItem>
      <TxFormItem>
        <TxButton variant="primary" native-type="submit" :loading="submitting">Create account</TxButton>
      </TxFormItem>
    </TxForm>
  </template>
---
:::

### Loading and Merging Data
`setBaseline()` loads fetched data; fields the user changed are kept unless `reconcile` decides otherwise.
:::TuffDemoWrapper{demo="FormBaselineDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { onMounted, reactive, ref } from 'vue'

  const formRef = ref()
  const profile = reactive({ name: '', role: '', bio: '' })

  async function refresh() {
    formRef.value.setBaseline(await fetch('/api/profile').then(res => res.json()))
  }

  // The server wins; without reconcile, fields the user changed are kept
  const serverWins = ({ incoming }) => incoming

  onMounted(refresh)
  </script>

  <template>
    <TxForm ref="formRef" v-slot="{ dirty }" :model="profile" :reconcile="serverWins" @submit="save">
      <TxFormItem label="Name" prop="name">
        <TuffInput v-model="profile.name" />
      </TxFormItem>
      <TxFormItem label="Role" prop="role">
        <TuffInput v-model="profile.role" />
      </TxFormItem>
      <TxFormItem>
        <TxButton @click="refresh">Refresh from server</TxButton>
        <TxButton variant="primary" native-type="submit" :disabled="!dirty">Save</TxButton>
        <TxButton native-type="reset" :disabled="!dirty">Restore</TxButton>
      </TxFormItem>
    </TxForm>
  </template>
---
:::

### Drafts
`persist` keeps what the user typed under the form's `id`, so a reload or a closed tab brings it back.
:::TuffDemoWrapper{demo="FormDraftDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { onMounted, reactive, ref } from 'vue'

  const props = defineProps<{ postId: number }>()
  const formRef = ref()
  const post = reactive({ title: '', body: '' })
  const loaded = ref(false)

  onMounted(async () => {
    formRef.value.setBaseline(await fetch(`/api/posts/${props.postId}`).then(res => res.json()))
    loaded.value = true
  })
  </script>

  <template>
    <TxForm id="post-editor" ref="formRef" :model="post" :persist="loaded && { recordId: postId }" @submit="save">
      <TxFormItem label="Title" prop="title">
        <TuffInput v-model="post.title" />
      </TxFormItem>
      <TxFormItem label="Body" prop="body">
        <TxTextarea v-model="post.body" />
      </TxFormItem>
    </TxForm>
  </template>
---
:::

### Leave Confirmation
`confirmLeave()` resolves whether to go, and asks only about changes no draft holds.

```ts
onBeforeRouteLeave(() => formRef.value.confirmLeave())
```

```vue
<!-- Escape, the mask and the close button all ask first -->
<TxModal v-model="open" :before-close="() => formRef?.confirmLeave()">
  <TxForm ref="formRef" :model="form">…</TxForm>
</TxModal>
```

### Schema Validation
`schema` takes any Standard Schema v1 validator and hands each issue to the field at its path.

```vue
<script setup lang="ts">
import { z } from 'zod'

const schema = z.object({
  email: z.string().email('Enter a valid email address'),
  age: z.number().int().min(18, 'You must be 18 or older'),
})
</script>

<template>
  <TxForm :model="form" :schema="schema">
    <TxFormItem label="Email" prop="email">
      <TuffInput v-model="form.email" />
    </TxFormItem>
    <TxFormItem label="Age" prop="age">
      <TxNumberInput v-model="form.age" />
    </TxFormItem>
  </TxForm>
</template>
```

### Custom Controls
TuffEx controls join the item around them on their own; bind the default slot's props on a native element, or call `useTxFormField()` in a component.

```vue
<TxFormItem v-slot="{ id, ariaInvalid, ariaDescribedby, required }" label="Accent colour" prop="color">
  <input :id="id" v-model="form.color" type="color" :aria-invalid="ariaInvalid" :aria-describedby="ariaDescribedby" :required="required">
</TxFormItem>
```

```ts
import { useTxFormField } from '@talex-touch/tuffex/form'

// In the custom control's setup
const field = useTxFormField('input')
const controlAttrs = computed(() => field?.attrs(attrs) ?? attrs)
const isDisabled = computed(() => props.disabled || !!field?.disabled)
```

### In a Plugin
A plugin view's `localStorage` goes with the view, so keep the drafts in the plugin's storage and write them before the view closes.

```ts
import { flushTxForms, provideTxFormHost } from '@talex-touch/tuffex/form'
import { LifeCycle, usePluginDraftStorage } from '@talex-touch/utils/plugin/sdk'

const app = createApp(App)
provideTxFormHost({ storage: usePluginDraftStorage() }, app)
LifeCycle.onBeforeClose(flushTxForms)
app.mount('#app')
```

### Best Practices

- Keep `model` the same reactive object; a new object is a new record, which resets the baseline and clears every message.
- Pass fetched data to `setBaseline()` instead of writing it into `model`, so `dirty` and `reset()` measure against it.
- Put shared rules in form-level `rules`; an item's `rules` replace the form-level rules for the same path rather than adding to them.
- Declare a validator that returns a promise `async`, and pass `signal` to its request.
- Turn `persist` on once the record has loaded, so the draft is laid over the saved values rather than empty ones.

## API Reference

### TxForm

#### Props

| Prop | Type | Default | Description |
|------|------|---------|-------------|
| `id` | `string` | generated | The `<form>` element's id, and the prefix of every field id: `<id>-<prop>`. |
| `model` | `Record<string, any>` | - | Reactive form data; items read their field by the `prop` path. |
| `rules` | `FormRules` | - | Form-level rules keyed by field path. |
| `schema` | `FormStandardSchema` | - | A Standard Schema v1 validator (Zod, Valibot, ArkType…) checked against the whole `model`. |
| `layout` | `'auto' \| 'side' \| 'stacked' \| 'inline'` | `'auto'` | Field layout; `auto` is `side` once the form is 520px wide and `stacked` below that; `inline` suits filter bars. |
| `labelPosition` | `'left' \| 'right' \| 'top'` | - | Older spelling of `layout`: `top` is `stacked`; `left` and `right` are `side` with that alignment. |
| `labelAlign` | `'start' \| 'end'` | `'end'` | Label alignment in the side column; `start` by default with `labelPosition="left"`. |
| `labelWidth` | `string \| number` | `16em` | Widest the side label column may grow, numbers in pixels; it stays narrower when every label is, and never exceeds 40% of the form. |
| `requiredMark` | `'asterisk' \| 'optional' \| 'none'` | `'asterisk'` | Marks required fields with an asterisk, optional fields with `messages.optional`, or neither. |
| `validateOn` | `'blur' \| 'submit'` | `'blur'` | When the first message appears: on leaving a changed field, or on the first submit. |
| `messages` | `Partial<FormMessages>` | - | Overrides the built-in text. |
| `size` | `'small' \| 'medium' \| 'large'` | `'medium'` | Passed to the controls inside that have sizes. |
| `disabled` | `boolean` | `false` | Disables every control inside that reads the form, and blocks submit. |
| `reconcile` | `FormReconcile` | - | Decides what `model` holds when `setBaseline()` or a draft brings values for fields the user changed. |
| `persist` | `boolean \| FormPersistOptions` | `false` | Keeps what the user typed under `id`; `true` takes the defaults. |
| `leaveConfirm` | `FormLeaveConfirm \| false` | host's, then `window.confirm` | Asked before leaving with changes no draft holds; `false` never asks, as for a filter. |

#### Events

| Event | Payload | Description |
|------|---------|-------------|
| `submit` | `(values: FormValues, event?: Event)` | Called once every check passes, with a copy of the values; a returned promise is awaited, and `submitting` is `true` meanwhile. |
| `validate` | `(valid: boolean)` | Fires after `validate()` has checked every field. |
| `persist-error` | `(error: unknown)` | A draft could not be read or written; fires once per run of failures. |

#### Slots

| Slot | Props | Description |
|------|------|-------------|
| `default` | `{ dirty, valid, submitting, submitted, errors, rootError }` | Form items and actions. |
| `draft` | `{ draft, notice, restore, discard }` | Replaces the notice above the fields while a draft has filled them in or waits. |

#### Exposed Methods

| Name | Type | Description |
|------|-----------|-------------|
| `dirty` | `boolean` | Read-only; `model` differs from the baseline. |
| `valid` | `boolean` | Read-only; no error blocks submit, whether or not it shows yet. |
| `submitting` | `boolean` | Read-only; the `submit` handler is running. |
| `submitted` | `boolean` | Read-only; the form has been submitted at least once; `reset()` clears it. |
| `errors` | `Record<string, string>` | Read-only; the errors showing, by field path. |
| `rootError` | `string` | Read-only; the form-level error. |
| `validate` | `() => Promise<boolean>` | Validates every field, shows the messages, and resolves to whether all passed. |
| `validateField` | `(path: string) => Promise<boolean>` | Validates one field and shows its message. |
| `submit` | `() => Promise<boolean>` | What a native submit does: validates, then calls the `submit` handler; resolves to whether it succeeded. |
| `reset` | `() => void` | Restores `model` to the baseline and clears every message. |
| `resetFields` | `() => void` | Older name of `reset()`. |
| `setBaseline` | `(values?: FormValues) => void` | Makes fetched values the baseline; without them, the current `model` becomes the baseline. |
| `setErrors` | `(errors: Record<string, string \| null \| undefined>, options?: { source?: 'server' \| 'client' }) => void` | Shows outside errors until the user edits the field; a `client` error also blocks submit. |
| `setRootError` | `(message?: string \| null) => void` | Sets or clears the form-level error. |
| `clearValidate` | `(paths?: string \| string[]) => void` | Hides messages without changing `model`. |
| `draft` | `FormDraftState` | Read-only; what the draft filled in or still offers, when it was written, whether writing fails. |
| `flush` | `() => Promise<void>` | Writes the draft now. |
| `confirmLeave` | `() => Promise<boolean>` | Call before leaving inside the app; resolves `true` to go. |
| `restoreDraft` | `() => Promise<boolean>` | Fills in the fields the draft still offers; resolves whether any were. |
| `discardDraft` | `() => Promise<void>` | Puts the saved values back where the draft filled them in, and deletes it. |

### TxFormItem

#### Props

| Prop | Type | Default | Description |
|------|------|---------|-------------|
| `label` | `string` | `''` | Label text; no label renders without it. |
| `prop` | `string` | - | The field's path in `model`: `name`, `meta.homepage`, `links[0].url`. |
| `rules` | `FormRule \| FormRule[]` | - | Rules for this field; they replace the form-level `rules` for the same path. |
| `required` | `boolean` | `false` | Shows the required marker and adds a `required` rule. |
| `help` | `string` | - | Helper text under the control; an error or warning takes its place while it shows. |
| `width` | `'xs' \| 'sm' \| 'md' \| 'lg' \| 'full'` | - | Control width: 80, 160, 240 or 360px, or the whole column. |
| `showMessage` | `boolean` | `true` | Shows the message under the control; with it off, the control is still marked invalid. |
| `inline` | `boolean` | `false` | Centres the label on the control; in a stacked layout, puts it beside the control. |
| `persist` | `boolean` | `true` | `false` keeps the field out of the draft, as a secret is. |

#### Events

| Event | Payload | Description |
|------|---------|-------------|
| `validate` | `(valid: boolean)` | Fires after this field validates: on leaving it changed, or when the form validates. |

#### Slots

| Slot | Props | Description |
|------|------|-------------|
| `default` | `{ id, labelId, ariaInvalid, ariaDescribedby, invalid, required }` | The field control; bind the props on a native element to link it to the label and message. |

