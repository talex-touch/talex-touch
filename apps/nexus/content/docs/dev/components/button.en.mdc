### Loading
The button is disabled while `loading`; on icon-only buttons the indicator sits over the icon.
::TuffDemoWrapper{demo="ButtonLoadingDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const loading = ref(false)

  async function submit() {
    loading.value = true
    try {
      await save()
    }
    finally {
      loading.value = false
    }
  }
  </script>

  <template>
    <TxButton variant="primary" :loading="loading" @click="submit">
      {{ loading ? 'Loading' : 'Click to load' }}
    </TxButton>
    <TxButton circle icon="i-carbon-edit" :loading="loading" @click="submit" />
  </template>
---
::

### Progress and Status
Setting `progress` (0–100) renders a background fill and numeric readout; setting `status` to `'success'`, `'warning'`, or `'error'` smoothly settles the fill into the semantic tone and draws the status glyph.
:::TuffDemoWrapper{demo="ButtonProgressDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const progress = ref<number | undefined>(undefined)
  const status = ref<'' | 'success' | 'warning' | 'error'>('')

  function startUpload() {
    status.value = ''
    progress.value = 18
    // Update progress as the job advances, then set status = 'success'
  }
  </script>

  <template>
    <TxButton variant="primary" :progress="progress" :status="status" @click="startUpload">
      {{ status === 'success' ? 'Published' : progress !== undefined ? 'Uploading' : 'Publish update' }}
    </TxButton>
  </template>
---
:::

