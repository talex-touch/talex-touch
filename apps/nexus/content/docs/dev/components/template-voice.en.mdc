## Usage

### Meeting notes
:::TuffDemoWrapper{demo="TemplateVoiceDemo" code-lang="vue" description="Records a stand-up once in view, stops by itself after about 15 seconds, and writes a summary with to-dos; the record key or another recording hands it to you. No microphone; the audio is synthesized in the page. Sample data."}
---
code: |
  <script setup lang="ts">
  import TemplateFrame from './TemplateFrame.vue'

  // The level is a getter: TxVoiceBeam samples it every frame from its own
  // loop, so the page never re-renders per frame
  function level() {
    return speaking ? syllableLoudness(now() - startedAt) : 0
  }

  // Recognized words arrive a few at a time; TxStreamText paces them on screen
  line.received = text.slice(0, end)

  // Stop: the clock ends, an unfinished sentence stays in the transcript only,
  // and the finished ones go to the summary
  function stopRecording() {
    endRecording()
    live.phase = 'processing'
    streamSummary()
  }
  </script>

  <template>
    <TemplateFrame title="Voice notes" @enter="start">
      <TxVoiceClip :src="row.src" :peaks="row.peaks" :duration-ms="row.durationMs" />
      <TxVoiceBeam :level="level" :active="busy" :processing="summarizing" :organic="1" :paused="!onScreen" :theme="theme">
        <button class="vnote-key" :aria-label="keyLabel" @click="onKey" />
      </TxVoiceBeam>
      <TxStreamText :content="line.received" :streaming="line.live" reveal="blur" />
      <TxBotAvatar :size="30" :state="botState" :paused="botPaused" :theme="theme" />
      <TxStreamText :content="point.received" :streaming="point.live" />
      <TxCheckbox v-model="checked[todo.key]" :label="todo.text" />
      <TxSuggestionChips :suggestions="suggestions" layout="list" @select="onSuggestion" />
      <TxToastPanel :open="toast.open" :tether="false" :stack="0">{{ toast.text }}</TxToastPanel>
    </TemplateFrame>
  </template>
