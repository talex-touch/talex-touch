  - name: full
    description: 'Opens at 100% on the active axis; same as `size="full"`.'
    type: 'boolean'
    default: 'false'
  - name: width
    description: 'Legacy alias; use `size`.'
    type: "number | string | 'full'"
    default: '-'
  - name: direction
    description: 'Edge the drawer slides in from.'
    type: "'left' | 'right' | 'top' | 'bottom'"
    default: "'right'"
  - name: showHeader
    description: 'Renders the header area.'
    type: 'boolean'
    default: 'true'
  - name: showFooter
    description: 'Renders the footer slot area.'
    type: 'boolean'
    default: 'true'
  - name: showClose
    description: 'Shows the close button in the default header.'
    type: 'boolean'
    default: 'true'
  - name: closeLabel
    description: "Accessible name of the default header's close button."
    type: 'string'
    default: "'Close drawer'"
  - name: closeOnClickMask
    description: 'Closes when the mask is clicked.'
    type: 'boolean'
    default: 'true'
  - name: closeOnPressEscape
    description: 'Closes when Escape is pressed.'
    type: 'boolean'
    default: 'true'
  - name: maskEffect
    description: 'Mask look: blurred, dimmed only, or transparent.'
    type: "'blur' | 'opacity' | 'transparent'"
    default: "'blur'"
  - name: panelTransparent
    description: 'Thins the colour under the panel material so more of the page shows through (see `surfaceOpacity`).'
    type: 'boolean'
    default: 'false'
  - name: surface
    description: 'Material of the panel.'
    type: "'pure' | 'mask' | 'blur' | 'glass' | 'refraction' | 'acrylic' | 'mica' | 'flat' | 'plain'"
    default: "'refraction'"
  - name: surfaceColor
    description: 'Colour laid under the material; empty uses `--tx-drawer-panel-background`, which follows the theme.'
    type: 'string'
    default: "''"
  - name: surfaceOpacity
    description: 'Opacity of that colour (0–1); when unset, `0.96` under `mask` and `0.5` otherwise, or `0.78` and `0.3` with `panelTransparent`. Used by `mask`, `blur`, `acrylic`, `glass` and `refraction`; always opaque under `pure` and `flat`, and `mica` and `plain` lay no base colour.'
    type: 'number'
    default: '-'
  - name: mobileAdapt
    description: 'Forces a bottom entrance when the viewport is 768px wide or less.'
    type: 'boolean'
    default: 'true'
  - name: zIndex
    description: 'Fixed layer; without it the z-index manager allocates from `10000`.'
    type: 'number'
    default: '-'
  - name: lazy
    description: 'Skips slot content until the first open, then keeps it; set `false` to mount eagerly.'
    type: 'boolean'
    default: 'true'
---
::

