code: |
  <script setup lang="ts">
  import type { DitherSeries } from '@talex-touch/tuffex/charts'
  import { TxDitherChart } from '@talex-touch/tuffex/charts'

  const series: DitherSeries[] = [
    { id: 'mobile', label: 'Mobile', value: 65 },
    { id: 'desktop', label: 'Desktop', value: 25 },
    { id: 'tablet', label: 'Tablet', value: 10 },
