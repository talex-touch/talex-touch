## 用法

### 基础
每次打开都编辑 `initialValues` 的一份副本；提交成功才关闭，有未保存的修改时关闭前先询问。
::::TuffDemoWrapper{demo="ModalFormBasicDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const open = ref(false)
  const member = ref({ name: '林晓', email: 'lin@example.com', role: 'editor' })
  const roles = [
    { value: 'owner', label: '所有者' },
    { value: 'editor', label: '编辑者' },
    { value: 'viewer', label: '查看者' },
  ]
  const rules = {
    name: { required: true, message: '请输入姓名' },
    email: { type: 'email', message: '邮箱格式不正确' },
  }

  // 返回的 Promise 完成前，对话框保持打开，保存按钮显示加载
  async function save(values) {
    await updateMember(values)
    member.value = values
  }
  </script>

  <template>
    <TxButton @click="open = true">编辑</TxButton>
    <TxModalForm
      v-model="open"
      title="编辑成员"
      :initial-values="member"
      :rules="rules"
      :messages="{ leaveConfirm: '有未保存的更改，仍要关闭吗？' }"
      submit-text="保存"
      cancel-text="取消"
      :modal-props="{ closeLabel: '关闭' }"
      @submit="save"
    >
      <template #default="{ model }">
        <TxFormItem label="姓名" prop="name">
          <TuffInput v-model="model.name" />
        </TxFormItem>
        <TxFormItem label="邮箱" prop="email">
          <TuffInput v-model="model.email" type="email" />
        </TxFormItem>
        <TxFormItem label="角色" prop="role">
          <TxSelect v-model="model.role" :options="roles" />
        </TxFormItem>
      </template>
    </TxModalForm>
  </template>
