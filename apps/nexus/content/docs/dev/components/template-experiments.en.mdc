  <script setup lang="ts">
  import type { HeatmapSelection, LearningCurveRun } from '@talex-touch/tuffex/charts'
  import { ChartPalette } from '@talex-touch/tuffex/charts'
  import { computed, reactive, ref } from 'vue'
  import TemplateFrame from './TemplateFrame.vue'

  // Six runs from a seeded generator: train/loss every 50 steps, validation every 200
  const live = reactive({ step: 1200, status: 'running' }) // r6 is still training
  const metric = ref('valAcc') // valAcc, valLoss or trainLoss
  const compared = ref(['r1', 'r2', 'r3', 'r4', 'r5', 'r6'])
  const view = ref<[number, number] | null>(null) // the step range a drag zoomed into

  // Each curve takes the chart palette's Nth colour; its row checkbox wears the same one
  const RUN_COLOR = Object.fromEntries(RUNS.map((run, index) => [run.id, ChartPalette.categoricalVar(index)]))
  const curveRuns = computed<LearningCurveRun[]>(() => RUNS.map(run => ({
    name: run.id,
    color: RUN_COLOR[run.id],
    data: run.id === 'r6'
      ? SERIES.r6[metric.value].filter(([step]) => step <= live.step)
      : SERIES[run.id][metric.value],
  })))

  // Hides the scale bar but keeps the colour mapping; one object, since TxEChart redraws on every new option
  const HEAT_OPTION = { visualMap: { show: false }, tooltip: { formatter: heatTooltip } }

  // After @enter, 80 steps every 100ms reach step 6,000 in about 6 seconds; Stop clears the timer
  function tick() {
    live.step = Math.min(6000, live.step + 80)
    if (live.step < 6000)
      later(100, tick)
    else
      finish() // marks the run finished and opens the TxToastPanel
  }

  // Boxing heatmap cells compares only those runs; clearing the box restores the comparison
  function onHeatSelect(selection: HeatmapSelection | null) {
    compared.value = selection
      ? selection.cells.map(cell => GRID_RUNS[cell.row][cell.column])
      : beforeBox
  }
  </script>

  <template>
    <TemplateFrame title="Experiments" @enter="start">
      <template #default="{ width, height }">
        <header class="exp-head">
          <TxWorkingIndicator v-if="live.status === 'running'" variant="dots" label="Training r6" :show-elapsed="false" />
          <TxFlatRadio v-model="metric" size="sm">
            <TxFlatRadioItem value="valAcc" label="val/acc" />
            <TxFlatRadioItem value="valLoss" label="val/loss" />
            <TxFlatRadioItem value="trainLoss" label="train/loss" />
          </TxFlatRadio>
          <TxButton size="sm" icon="i-carbon-stop-filled-alt" @click="stop">Stop</TxButton>
        </header>

        <section class="exp-chart">
          <TxChartLegendItem
            v-for="run in RUNS" :key="run.id" :name="run.id" :color="RUN_COLOR[run.id]"
            :inactive="!compared.includes(run.id)" @click="toggle(run.id)"
          />
          <TxLearningCurve
            v-model:window="view" :runs="curveRuns" :hidden-runs="hidden" :highlighted-run="hovered"
            x-axis-name="Training step" :y-axis-name="METRIC_LABEL[metric]" :height="chartHeight(width, height)"
          />
        </section>

        <aside class="exp-side">
          <TxHeatmapChart
            :values="heatValues" :rows="['bs 64', 'bs 128']" :columns="['lr 1e-4', 'lr 3e-4', 'lr 1e-3']"
            :min="0.75" :max="0.92" show-label :selectable="heatSelectable" :option="HEAT_OPTION"
            @select="onHeatSelect" @click="focusCell"
          />
          <TxDescriptions size="sm" :columns="1">
            <TxDescriptionsItem v-for="item in configItems" :key="item.key" :label="item.label">
              {{ item.value }}
            </TxDescriptionsItem>
          </TxDescriptions>
