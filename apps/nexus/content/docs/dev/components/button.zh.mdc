### 加载中
`loading` 期间按钮禁用；纯图标按钮的加载指示叠在图标上。
::TuffDemoWrapper{demo="ButtonLoadingDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const loading = ref(false)

  async function submit() {
    loading.value = true
    try {
      await save()
    }
    finally {
      loading.value = false
    }
  }
  </script>

  <template>
    <TxButton variant="primary" :loading="loading" @click="submit">
      {{ loading ? '加载中' : '点击加载' }}
    </TxButton>
    <TxButton circle icon="i-carbon-edit" :loading="loading" @click="submit" />
  </template>
---
::

### 进度与结果状态
传入 `progress`（0–100）时渲染背景填充与数字读数；`status` 设为 `'success'`、`'warning'` 或 `'error'` 时，进度填充连贯收拢为语义色调并绘制对应状态图形。
:::TuffDemoWrapper{demo="ButtonProgressDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const progress = ref<number | undefined>(undefined)
  const status = ref<'' | 'success' | 'warning' | 'error'>('')

  function startUpload() {
    status.value = ''
    progress.value = 18
    // 随上传进度更新 progress，完成后设置 status = 'success'
  }
  </script>

  <template>
    <TxButton variant="primary" :progress="progress" :status="status" @click="startUpload">
      {{ status === 'success' ? '发布成功' : progress !== undefined ? '正在上传' : '发布更新' }}
    </TxButton>
  </template>
---
:::

