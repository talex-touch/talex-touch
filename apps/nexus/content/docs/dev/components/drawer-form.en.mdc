---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const open = ref(false)
  const projects = ref([])
  // Every open starts from these
  const blank = { name: '', key: '', description: '', visibility: 'team' }
  const rules = {
    name: { required: true, message: 'Enter a project name' },
    key: { pattern: /^[A-Z][A-Z0-9]{1,9}$/, message: 'Use 2 to 10 capital letters or digits, starting with a letter' },
  }

  async function create(values) {
    const project = await createProject(values)
    projects.value = [project, ...projects.value]
  }
  </script>

  <template>
    <TxButton variant="primary" @click="open = true">New project</TxButton>
    <TxDrawerForm
      v-model:visible="open"
      title="New project"
      :initial-values="blank"
      :rules="rules"
      :drawer-props="{ size: 'min(92vw, 440px)' }"
      layout="stacked"
      submit-text="Create"
      @submit="create"
    >
      <template #default="{ model }">
        <TxFormItem label="Name" prop="name">
          <TuffInput v-model="model.name" />
        </TxFormItem>
        <TxFormItem label="Key" prop="key" help="2 to 10 capital letters or digits, starting with a letter" width="sm">
          <TuffInput v-model="model.key" />
        </TxFormItem>
        <TxFormItem label="Description" prop="description">
          <TxTextarea v-model="model.description" :rows="3" resize="none" />
        </TxFormItem>
        <TxFormItem label="Visibility" prop="visibility">
          <TxRadioGroup v-model="model.visibility" type="standard" direction="row">
            <TxRadio value="private" label="Only me" />
            <TxRadio value="team" label="Team" />
            <TxRadio value="public" label="Public" />
          </TxRadioGroup>
        </TxFormItem>
      </template>
    </TxDrawerForm>
  </template>
