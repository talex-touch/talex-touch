## Usage

### Basic
`origin` returns each image's thumbnail, so the preview grows out of it and shrinks back into it on closing; zoom with the wheel, a trackpad, or two fingers, swipe sideways to page, and drag up or down to close.
::::TuffDemoWrapper{demo="ImagePreviewBasicDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const images = [
    { url: '/shots/search.jpg', thumbnail: '/shots/search-s.jpg', name: 'File search', width: 1668, height: 1080 },
    { url: '/photos/fjord.jpg', thumbnail: '/photos/fjord-s.jpg', name: 'Fjord panorama', width: 3000, height: 1000 },
    { url: '/photos/alley.jpg', thumbnail: '/photos/alley-s.jpg', name: 'Brick alley', width: 1200, height: 1800 },
  ]

  const open = ref(false)
  const index = ref(0)
  const grid = ref<HTMLElement | null>(null)

  // Image i flies out of thumbnail i, and back into it on closing
  function thumbOf(i: number) {
    return grid.value?.children[i] ?? null
  }

  function show(at: number, event: MouseEvent) {
    // WebKit does not focus a clicked button; focused first, it gets the focus back on close
    ;(event.currentTarget as HTMLElement).focus()
    index.value = at
    open.value = true
  }
  </script>

  <template>
    <div ref="grid">
      <button v-for="(image, i) in images" :key="image.url" type="button" @click="show(i, $event)">
        <img :src="image.thumbnail" alt="">
      </button>
    </div>

    <TxImagePreview
      v-model:open="open"
      v-model:index="index"
      :images="images"
      :origin="thumbOf"
    />
  </template>
---
