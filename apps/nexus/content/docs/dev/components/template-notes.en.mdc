## Usage

### Shared notes
:::TuffDemoWrapper{demo="TemplateNotesDemo" code-lang="vue" description="In view, Lin joins and types a to-do one character at a time, then Zhou comments on it; click anywhere to take over."}
---
code: |
  <script setup lang="ts">
  import type { MarkdownEditorCollaboration, MarkdownEditorCollaborationHandlers } from '@talex-touch/tuffex/markdown-editor'
  import { ref } from 'vue'
  import TemplateFrame from './TemplateFrame.vue'

  const body = ref(NOTE) // Markdown source: the editor's v-model
  const comments = ref(THREADS) // anchored threads, kept in step with every edit

  // One adapter for the whole session: a new object restarts it. Without
  // sendPresence the editor runs no presence timer.
  let handlers: MarkdownEditorCollaborationHandlers | null = null
  const collaboration: MarkdownEditorCollaboration = {
    send: () => markEdited('me'),
    subscribe(next) {
      handlers = next
      next.onPeers?.(peers())
      return () => (handlers = null)
    },
  }

  // A scripted colleague types through the same path a server would use
  function peerType(at: number, text: string) {
    handlers?.onChanges([{ from: at, to: at, insert: text }])
    lin.selection = { anchor: at + text.length, head: at + text.length }
    handlers?.onPeers?.(peers())
  }
  </script>

  <template>
    <TemplateFrame title="Notes" :height="600" @enter="play">
      <aside class="notes__nav">
        <TxSearchInput v-model="query" placeholder="Search notes" />
        <TxTree :nodes="tree" :model-value="activeId" :filter-text="query" @select="open" />
      </aside>

      <section class="notes__main">
        <TxBreadcrumb :items="crumbs" />
        <TxAvatarGroup :size="24">
          <TxAvatar v-for="person in present" :key="person.id" :name="person.name" />
        </TxAvatarGroup>
        <TxMarkdownEditor
          :key="activeId" v-model="body" v-model:comments="comments"
          :user="me" :collaboration="collaboration" :ai="ai" :min-height="0"
        />
      </section>

      <!-- Shown from 960px by a container query -->
      <aside class="notes__panel">
        <TxDescriptions :columns="1" size="sm">
          <TxDescriptionsItem label="Words">{{ words }}</TxDescriptionsItem>
        </TxDescriptions>
      </aside>
    </TemplateFrame>
  </template>
---
