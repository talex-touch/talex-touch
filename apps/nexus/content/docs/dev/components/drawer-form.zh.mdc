## 用法

### 基础
抽屉留出页面上下文，适合字段较多的表单；每次打开编辑 `initialValues` 的副本，提交成功才关闭。
::::TuffDemoWrapper{demo="DrawerFormBasicDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const open = ref(false)
  const projects = ref([])
  // 每次打开都从这里开始
  const blank = { name: '', key: '', description: '', visibility: 'team' }
  const rules = {
    name: { required: true, message: '请输入项目名称' },
    key: { pattern: /^[A-Z][A-Z0-9]{1,9}$/, message: '标识需要 2 到 10 位大写字母或数字，以字母开头' },
  }

  async function create(values) {
    const project = await createProject(values)
    projects.value = [project, ...projects.value]
  }
  </script>

  <template>
    <TxButton variant="primary" @click="open = true">新建项目</TxButton>
    <TxDrawerForm
      v-model:visible="open"
      title="新建项目"
      :initial-values="blank"
      :rules="rules"
      :messages="{ leaveConfirm: '有未保存的更改，仍要关闭吗？' }"
      :drawer-props="{ size: 'min(92vw, 440px)', closeLabel: '关闭抽屉' }"
      layout="stacked"
      submit-text="创建"
      cancel-text="取消"
      @submit="create"
    >
      <template #default="{ model }">
        <TxFormItem label="名称" prop="name">
          <TuffInput v-model="model.name" />
        </TxFormItem>
        <TxFormItem label="标识" prop="key" help="2 到 10 位大写字母或数字，以字母开头" width="sm">
          <TuffInput v-model="model.key" />
        </TxFormItem>
        <TxFormItem label="描述" prop="description">
          <TxTextarea v-model="model.description" :rows="3" resize="none" />
        </TxFormItem>
        <TxFormItem label="可见范围" prop="visibility">
          <TxRadioGroup v-model="model.visibility" type="standard" direction="row">
            <TxRadio value="private" label="仅自己" />
            <TxRadio value="team" label="团队" />
            <TxRadio value="public" label="公开" />
          </TxRadioGroup>
        </TxFormItem>
      </template>
    </TxDrawerForm>
  </template>
