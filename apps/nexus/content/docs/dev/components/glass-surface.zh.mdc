  - name: redOffset
    type: number
    default: 0
    description: 叠加到 distortionScale 上的红色偏移。
  - name: greenOffset
    type: number
    default: 10
    description: 叠加到 distortionScale 上的绿色偏移。
  - name: blueOffset
    type: number
    default: 20
    description: 叠加到 distortionScale 上的蓝色偏移。
  - name: xChannel
    type: "'R' | 'G' | 'B'"
    default: "'R'"
    description: 三张位移图的 X 轴取色通道。
  - name: yChannel
    type: "'R' | 'G' | 'B'"
    default: "'G'"
    description: 三张位移图的 Y 轴取色通道。
  - name: mixBlendMode
    type: "'normal' | 'multiply' | 'screen' | 'overlay' | 'darken' | 'lighten' | 'color-dodge' | 'color-burn' | 'hard-light' | 'soft-light' | 'difference' | 'exclusion' | 'hue' | 'saturation' | 'color' | 'luminosity' | 'plus-darker' | 'plus-lighter'"
