  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . --quiet",
    "lint:fix": "eslint --cache --fix .",
    "test": "vitest run",
    "test:core-main": "vitest run \"src/main/core\" \"src/main/channel\" \"src/main/modules/tray\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "pnpm -F @talex-touch/tuffex run build && vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "scan:memory:benchmark": "pnpm exec tsx scripts/file-scan-memory-benchmark.mjs",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:omnipanel": "vitest run src/main/modules/omni-panel/index.test.ts src/renderer/src/views/omni-panel/filter-features.test.ts src/renderer/src/views/omni-panel/interaction.test.ts",
    "test:shortcut-lifecycle": "vitest run src/main/modules/global-shortcon.test.ts src/main/modules/division-box/shortcut-trigger.test.ts src/main/modules/omni-panel/index.test.ts",
    "smoke:plugin-view-preload": "electron scripts/plugin-view-preload-smoke.cjs",
    "smoke:plugin-host-isolation": "electron scripts/plugin-host-isolation-smoke.cjs",
    "smoke:privacy-lifecycle": "electron out/main/privacy-lifecycle-smoke.js",
    "smoke:local-ai-cli-runtime": "node scripts/smoke-local-ai-cli-runtime.cjs",
    "start": "electron-vite preview",
    "release:notes:catalog": "node ../../scripts/generate-release-notes-catalog.mjs",
    "dev": "pnpm run release:notes:catalog && node scripts/dev-electron-wrapper.mjs",
    "build": "pnpm run release:notes:catalog && pnpm run typecheck && electron-vite build",
    "build:vite": "pnpm run release:notes:catalog && electron-vite build",
    "postinstall": "node scripts/ensure-node-pty-helper.cjs && node scripts/ensure-fd-binary.cjs && echo 'Skipping electron-builder install-app-deps - will run during build'",
    "db:generate": "node scripts/db/assert-snapshot-baseline.mjs && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:target": "node scripts/build-target.js",
    "perf:bundle:size": "node scripts/bundle-size-report.mjs",
    "startup:bench:dev": "node \"scripts/startup-benchmark-dev.mjs\" --mode run --runs 30 --continueOnFail",
    "startup:bench:packaged:hot": "node \"scripts/startup-benchmark-dev.mjs\" --target packaged --profile hot --mode run --runs 10 --continueOnFail",
    "startup:bench:packaged:cold": "node \"scripts/startup-benchmark-dev.mjs\" --target packaged --profile cold --mode run --runs 10 --continueOnFail",
    "startup:bench:analyze": "node \"scripts/startup-benchmark-dev.mjs\" --mode analyze",
    "visible:experience:template": "pnpm exec tsx \"scripts/coreapp-visible-experience-template.ts\"",
    "visible:experience:verify": "pnpm exec tsx \"scripts/coreapp-visible-experience-verify.ts\"",
    "visible:experience:readiness": "pnpm exec tsx \"scripts/coreapp-visible-experience-readiness.ts\"",
    "visible:experience:ai-ask-probe": "pnpm exec tsx \"scripts/coreapp-packaged-ai-ask-probe.ts\"",
    "acceptance:packaged:ai-provider": "pnpm exec tsx \"scripts/coreapp-packaged-ai-provider-acceptance.ts\"",
    "acceptance:packaged:ai-failure-matrix": "pnpm exec tsx \"scripts/coreapp-packaged-ai-failure-matrix.ts\"",
    "acceptance:packaged:ai-auxiliary": "pnpm exec tsx \"scripts/coreapp-packaged-ai-auxiliary-acceptance.ts\"",
    "acceptance:packaged:ai-verify": "node --no-deprecation --import tsx \"scripts/coreapp-packaged-ai-evidence-verify.ts\"",
    "visible:experience:app-index-workbench-probe": "pnpm exec tsx \"scripts/coreapp-visible-app-index-workbench-probe.ts\"",
    "visible:experience:workflow-review-queue-probe": "pnpm exec tsx \"scripts/coreapp-visible-workflow-review-queue-probe.ts\"",
    "visible:experience:login-recovery-probe": "pnpm exec tsx \"scripts/coreapp-packaged-login-recovery-probe.ts\"",
    "visible:experience:indexing-diagnostics-probe": "pnpm exec tsx \"scripts/coreapp-packaged-indexing-diagnostics-probe.ts\"",
    "visible:experience:indexing-diagnostics-attach": "pnpm exec tsx \"scripts/coreapp-packaged-indexing-diagnostics-probe.ts\" -- --attachOnly",
    "windows:corebox-everything:probe": "pnpm exec tsx \"scripts/coreapp-packaged-corebox-everything-probe.ts\"",
    "everything:corebox-ui:verify": "pnpm exec tsx \"scripts/everything-corebox-ui-verify.ts\"",
    "clipboard:stress": "pnpm exec tsx \"scripts/clipboard-polling-stress.ts\"",
    "clipboard:stress:verify": "pnpm exec tsx \"scripts/clipboard-stress-verify.ts\"",
    "app-index:diagnostic:verify": "pnpm exec tsx \"scripts/app-index-diagnostic-verify.ts\"",
    "everything:diagnostic:verify": "pnpm exec tsx \"scripts/everything-diagnostic-verify.ts\"",
    "release-notes:visual:probe": "pnpm exec tsx \"scripts/coreapp-visible-release-notes-probe.ts\"",
    "search-split:topology:verify": "pnpm exec tsx \"scripts/search-split-topology-verify.ts\"",
    "search-split:app-evidence": "pnpm exec tsx \"scripts/search-split-app-evidence.ts\"",
    "search-split:app-evidence:self-check": "pnpm exec tsx \"scripts/search-split-app-evidence.ts\" --self-check",
    "settings:indexing-diagnostics:verify": "pnpm exec tsx \"scripts/settings-indexing-diagnostics-verify.ts\"",
    "search:fts-ownership-simulate": "pnpm exec tsx \"scripts/search-index-fts-ownership-simulation.ts\"",
    "search:index-migration:preflight": "pnpm exec tsx \"scripts/search-index-migration-preflight.ts\"",
    "search:index-migration:evidence-verify": "pnpm exec tsx \"scripts/search-index-migration-evidence-verify.ts\"",
    "search:production-migration-readiness": "pnpm exec tsx \"scripts/search-index-production-migration-readiness.ts\"",
    "search:scan-progress-simulate": "pnpm exec tsx \"scripts/scan-progress-source-scope-simulation.ts\"",
    "search:scan-progress-migration": "pnpm exec tsx \"scripts/scan-progress-source-scope-migration.ts\"",
    "update:diagnostic:verify": "pnpm exec tsx \"scripts/update-diagnostic-verify.ts\"",
    "search:trace:stats": "pnpm exec tsx \"scripts/search-trace-stats.ts\"",
    "search:trace:verify": "pnpm exec tsx \"scripts/search-trace-verify.ts\"",
    "windows:capability:evidence": "pnpm exec tsx \"scripts/windows-capability-evidence.ts\"",
    "windows:capability:verify": "pnpm exec tsx \"scripts/windows-capability-verify.ts\"",
    "windows:acceptance:template": "pnpm exec tsx \"scripts/windows-acceptance-template.ts\"",
    "windows:acceptance:verify": "pnpm exec tsx \"scripts/windows-acceptance-verify.ts\"",
    "quickops:surface:audit": "pnpm exec tsx \"scripts/quickops-surface-audit.ts\"",
    "quickops:flow-ai:audit": "pnpm exec tsx \"scripts/quickops-flow-ai-adapter-audit.ts\"",
    "quickops:evidence:template": "pnpm exec tsx \"scripts/quickops-evidence-template.ts\"",
    "quickops:evidence:verify": "pnpm exec tsx \"scripts/quickops-evidence-verify.ts\"",
    "context:entrypoint:evidence:verify": "pnpm exec tsx \"scripts/context-entrypoint-evidence.ts\"",
    "check:search-index-writers": "node scripts/check-search-index-writers.mjs",
    "check:search-index-writers:self-test": "node scripts/check-search-index-writers.mjs --self-test",
    "check:permission-api-mappings": "node scripts/check-permission-api-mappings.mjs",
    "check:permission-api-mappings:self-test": "node scripts/check-permission-api-mappings.mjs --self-test",
    "check:app-root-single-source": "node scripts/check-app-root-single-source.mjs",
    "check:app-root-single-source:self-test": "node scripts/check-app-root-single-source.mjs --self-test"
  },
